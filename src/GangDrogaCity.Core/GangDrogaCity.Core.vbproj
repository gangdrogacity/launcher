<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GangDrogaCity.Core</RootNamespace>
    <AssemblyName>GangDrogaCity.Core</AssemblyName>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionExplicit>On</OptionExplicit>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Nessuna dipendenza da UI: questa libreria gira su Windows, Linux e macOS -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.IO" />
    <Import Include="System.Linq" />
    <Import Include="System.Collections.Generic" />
  </ItemGroup>

</Project>
