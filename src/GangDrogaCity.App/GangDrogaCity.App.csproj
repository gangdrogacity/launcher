<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GangDrogaCity</AssemblyName>
    <RootNamespace>GangDrogaCity.App</RootNamespace>
    <!-- Versione del launcher: usata anche dal controllo aggiornamenti (confronto con il tag della release) -->
    <Version>2.2.6.0</Version>
    <AssemblyVersion>2.2.6.0</AssemblyVersion>
    <FileVersion>2.2.6.0</FileVersion>
    <ApplicationIcon>Assets/launcher.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Publish: un singolo eseguibile autosufficiente per piattaforma -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GangDrogaCity.Core/GangDrogaCity.Core.vbproj" />
  </ItemGroup>

</Project>
